# Dedicated Arkitect Supabase project (safe, publishable values only).
# Copy this file to .env.local and fill in real values to enable live data.
# Without these, the site runs on local in-memory mock data automatically.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional public download URL (unused on the open-source mcp.json install path).
# Production builds use apps/site/.env.production (committed). Override locally via .env.local.
# Example: https://github.com/ezequielcasillas1/Arkitect-MCP.AI/releases/download/v2.1.0/Arkitect-Setup.exe
VITE_DOWNLOAD_URL=
# Public Buy Me a Coffee page (https only). Used for the donation button.
# Example: https://www.buymeacoffee.com/casiezeq
VITE_BUY_ME_A_COFFEE_URL=https://www.buymeacoffee.com/casiezeq
